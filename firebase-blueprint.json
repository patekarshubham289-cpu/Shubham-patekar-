{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Authenticated patient or clinician profile stored at /profiles/{userId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "phone": { "type": "string", "maxLength": 32 },
        "avatar": { "type": "string", "maxLength": 500 },
        "bloodGroup": { "type": "string", "maxLength": 10 },
        "age": { "type": "integer" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "bmi": { "type": "number" },
        "medicalConditions": { "type": "array" },
        "allergies": { "type": "array" },
        "isDonor": { "type": "boolean" },
        "role": { "type": "string", "enum": ["patient", "admin", "doctor"] },
        "settings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "email", "role", "createdAt", "updatedAt"]
    },
    "HealthRecord": {
      "title": "HealthRecord",
      "description": "Patient vital measurements and wellness log",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
        "heartRate": { "type": "number" },
        "bloodPressureSys": { "type": "number" },
        "bloodPressureDia": { "type": "number" },
        "bloodSugar": { "type": "number" },
        "bmi": { "type": "number" },
        "weightKg": { "type": "number" },
        "temperatureC": { "type": "number" },
        "spO2": { "type": "number" },
        "waterIntakeMl": { "type": "number" },
        "sleepHours": { "type": "number" },
        "mood": { "type": "string", "enum": ["Excellent", "Good", "Neutral", "Fatigued", "Unwell"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "timestamp", "heartRate", "bloodPressureSys", "bloodPressureDia", "bloodSugar", "spO2", "mood", "createdAt", "updatedAt"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Medical specialist directory profile managed by administrators, distinguishing demo profiles from verified clinicians",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "specialty": { "type": "string", "minLength": 2, "maxLength": 80 },
        "experienceYears": { "type": "integer" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "feeUsd": { "type": "number" },
        "photo": { "type": "string", "maxLength": 500 },
        "address": { "type": "string", "maxLength": 240 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "hospital": { "type": "string", "maxLength": 160 },
        "availableSlots": { "type": "array" },
        "bio": { "type": "string", "maxLength": 1000 },
        "languages": { "type": "array" },
        "verified": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["demo", "pending", "verified"] },
        "licenseNumber": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "title", "specialty", "feeUsd", "hospital", "verified", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Patient medical consultation booking linked to userId and doctorId",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "doctorSpecialty": { "type": "string", "minLength": 1, "maxLength": 80 },
        "doctorPhoto": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 32 },
        "timeSlot": { "type": "string", "maxLength": 32 },
        "type": { "type": "string", "enum": ["In-Person", "Video Consultation"] },
        "status": { "type": "string", "enum": ["Upcoming", "Completed", "Cancelled"] },
        "symptoms": { "type": "string", "maxLength": 1000 },
        "meetingLink": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "doctorId", "doctorName", "doctorSpecialty", "date", "timeSlot", "type", "status", "createdAt", "updatedAt"]
    },
    "DoctorSlotLock": {
      "title": "DoctorSlotLock",
      "description": "Non-PII doctor appointment slot reservation preventing concurrent double-bookings",
      "type": "object",
      "properties": {
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "timeSlot": { "type": "string", "minLength": 2, "maxLength": 32 },
        "bookedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "appointmentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["doctorId", "date", "timeSlot", "bookedByUid", "appointmentId", "active", "createdAt", "updatedAt"]
    },
    "MedicineReminder": {
      "title": "MedicineReminder",
      "description": "Patient medication schedule and adherence state",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "dosage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "frequency": { "type": "string", "enum": ["Daily", "Weekly", "As Needed"] },
        "timeSlots": { "type": "array" },
        "instructions": { "type": "string", "enum": ["Before Food", "After Food", "With Water"] },
        "pillsLeft": { "type": "integer" },
        "takenToday": { "type": "boolean" },
        "lastTakenDate": { "type": "string", "maxLength": 32 },
        "completedDates": { "type": "array" },
        "missedDates": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "dosage", "frequency", "timeSlots", "instructions", "pillsLeft", "takenToday", "active", "createdAt", "updatedAt"]
    },
    "MedicineScan": {
      "title": "MedicineScan",
      "description": "AI medicine scan result archived by a patient",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "composition": { "type": "string", "maxLength": 500 },
        "expiryDate": { "type": "string", "maxLength": 160 },
        "uses": { "type": "array" },
        "benefits": { "type": "array" },
        "sideEffects": { "type": "array" },
        "dosage": { "type": "string", "maxLength": 500 },
        "warnings": { "type": "array" },
        "storage": { "type": "string", "maxLength": 300 },
        "alternativeMedicines": { "type": "array" },
        "priceRange": { "type": "string", "maxLength": 100 },
        "disclaimer": { "type": "string", "maxLength": 500 },
        "saved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "timestamp", "name", "composition", "dosage", "saved", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "AI Health Companion conversation turn owned by userId",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sender": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "category": { "type": "string", "enum": ["general", "symptom", "medicine", "diet", "report"] },
        "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sender", "text", "timestamp", "createdAt", "updatedAt"]
    },
    "EmergencyContact": {
      "title": "EmergencyContact",
      "description": "Designated emergency contact for a patient",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "relation": { "type": "string", "minLength": 1, "maxLength": 80 },
        "phone": { "type": "string", "minLength": 3, "maxLength": 32 },
        "isPrimary": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "relation", "phone", "isPrimary", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-scoped notification alert",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "type": { "type": "string", "enum": ["reminder", "appointment", "sos", "system"] },
        "read": { "type": "boolean" },
        "appointmentId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt", "updatedAt"]
    },
    "EmergencyEvent": {
      "title": "EmergencyEvent",
      "description": "Truthful emergency SOS request & contact notification audit event",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientName": { "type": "string", "maxLength": 120 },
        "sosId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userLocation": { "type": "string", "maxLength": 240 },
        "gpsAvailable": { "type": "boolean" },
        "coordinates": { "type": "object" },
        "status": { "type": "string", "enum": ["REQUESTED", "CONTACTS_NOTIFIED", "ACKNOWLEDGED", "RESOLVED", "CANCELLED"] },
        "responseStatus": { "type": "string", "maxLength": 240 },
        "notificationAttempts": { "type": "array" },
        "notifiedContactsCount": { "type": "integer" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sosId", "userLocation", "gpsAvailable", "status", "responseStatus", "notifiedContactsCount", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator lookup document",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative audit trail entry",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "targetType": { "type": "string", "enum": ["doctor", "appointment", "user", "emergency", "system"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorEmail", "action", "targetType", "details", "createdAt"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Private patient profiles keyed by Firebase Auth UID"
    },
    "/health_records/{recordId}": {
      "schema": { "$ref": "#/entities/HealthRecord" },
      "description": "Patient vital logs scoped by userId"
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/Doctor" },
      "description": "Specialist directory (verified & demo-flagged profiles) readable by signed-in users and managed by admins"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Patient doctor appointments linked via userId and doctorId"
    },
    "/doctor_slots/{slotId}": {
      "schema": { "$ref": "#/entities/DoctorSlotLock" },
      "description": "Non-PII appointment slot locks preventing double-booking per doctor/date/time"
    },
    "/medicine_reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/MedicineReminder" },
      "description": "Patient medication schedules scoped by userId"
    },
    "/medicine_scan_history/{scanId}": {
      "schema": { "$ref": "#/entities/MedicineScan" },
      "description": "Saved AI medicine scan history scoped by userId"
    },
    "/chat_history/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Patient AI health companion messages scoped by userId"
    },
    "/emergency_contacts/{contactId}": {
      "schema": { "$ref": "#/entities/EmergencyContact" },
      "description": "Patient emergency contacts scoped by userId"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications scoped by userId"
    },
    "/emergency_events/{eventId}": {
      "schema": { "$ref": "#/entities/EmergencyEvent" },
      "description": "Emergency SOS events scoped by userId and auditable by admins"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted admin registry"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable administrative audit logs readable & creatable by verified admins"
    }
  }
}
